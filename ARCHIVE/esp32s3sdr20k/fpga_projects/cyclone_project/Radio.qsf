# Project-Wide Assignments
# ========================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 15.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "15:25:28  DECEMBER 02, 2024"
set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"

# Pin & Location Assignments
# ==========================
set_location_assignment PIN_E4 -to led
set_location_assignment PIN_AB11 -to clock_61M

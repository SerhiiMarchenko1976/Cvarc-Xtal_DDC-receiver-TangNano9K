//------------------------------------------------------------------------------
// ИСПРАВЛЕНО ДЛЯ TANG NANO 9K: Устранены конфликты пересечения шины SPI и data_io
//------------------------------------------------------------------------------

IO_PORT "test" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Фильтры ДПФ (Пины 70-74 свободны)
IO_LOC "filter[4]" 74;
IO_PORT "filter[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "filter[3]" 73;
IO_PORT "filter[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "filter[2]" 72;
IO_PORT "filter[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "filter[1]" 71;
IO_PORT "filter[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "filter[0]" 70;
IO_PORT "filter[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ПЕРЕНЕСЕНО: att_on сдвинут на свободный пин 68, чтобы освободить место для SPI
IO_LOC "att_on" 68;
IO_PORT "att_on" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "preamp_on" 75;
IO_PORT "preamp_on" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_pwm" 76;
IO_PORT "dac_pwm" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "adc_off" 54;
IO_PORT "adc_off" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_clk" 42;
IO_PORT "dac_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_clk" 31;
IO_PORT "adc_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Шина радио-данных (Пины 35-40 остаются неприкосновенными под ЦАП/АЦП)
IO_LOC "data_io[13]" 38;
IO_PORT "data_io[13]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[12]" 37;
IO_PORT "data_io[12]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[11]" 36;
IO_PORT "data_io[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[10]" 39;
IO_PORT "data_io[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[9]" 25;
IO_PORT "data_io[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[8]" 26;
IO_PORT "data_io[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[7]" 27;
IO_PORT "data_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[6]" 28;
IO_PORT "data_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[5]" 29;
IO_PORT "data_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[4]" 30;
IO_PORT "data_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[3]" 33;
IO_PORT "data_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[2]" 34;
IO_PORT "data_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[1]" 40;
IO_PORT "data_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "data_io[0]" 35;
IO_PORT "data_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Сигналы управления трансивером
IO_LOC "n_ptt" 56;
IO_PORT "n_ptt" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "n_tune" 55;
IO_PORT "n_tune" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// ПЕРЕНЕСЕНО: n_cw_key сдвинут на свободный пин 69, чтобы освободить место для SPI
IO_LOC "n_cw_key" 69;
IO_PORT "n_cw_key" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

//------------------------------------------------------------------------------
// ОФИЦИАЛЬНЫЙ СТАНДАРТ ТАКТОВОЙ ШИНЫ SPI ДЛЯ СВЯЗИ С ESP32 (Пины 41, 48, 49, 51)
//------------------------------------------------------------------------------
// 1. SPI_SS (Chip Select) — СТРОГО ВВЕРХ (PULL_MODE=UP)
// Когда ESP32 отключен, здесь будет железобетонная единица. 
// Модуль SPI внутри FPGA будет крепко спать и полностью игнорировать любые наводки.
IO_LOC "SPI_SS" 51;
IO_PORT "SPI_SS" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 2. SPI_SCK (Тактовая частота) — СТРОГО ВВЕРХ (PULL_MODE=UP)
// Фиксирует линию тактов в стабильном состоянии, исключая ложные фронты posedge.
IO_LOC "SPI_SCK" 49;  
IO_PORT "SPI_SCK" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 3. SPI_MOSI (Вход данных) — РЕКОМЕНДУЕТСЯ ВВЕРХ (PULL_MODE=UP)
// Фиксирует вход данных в состоянии логической единицы.
IO_LOC "SPI_MOSI" 48; 
IO_PORT "SPI_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 4. SPI_MISO (Выход данных из FPGA) — ПОДТЯЖКА НЕ НУЖНА
// Поскольку это выходной порт самой FPGA, он сам жестко удерживает уровень, 
// когда модуль SPI активен. Задаем только повышенную мощность прокачки DRIVE=8.
IO_LOC "SPI_MISO" 41; 
IO_PORT "SPI_MISO" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;


// Системный тактовый генератор и старт
IO_LOC "start" 32;
IO_PORT "start" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sys_clk" 52;  // Штатный кварц 27 МГц платы Tang Nano 9K
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
